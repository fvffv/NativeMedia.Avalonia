<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <SmokeTargetFramework Condition="'$(SmokeTargetFramework)' == ''">net10.0</SmokeTargetFramework>
    <TargetFramework>$(SmokeTargetFramework)</TargetFramework>
    <SmokeAvaloniaVersion Condition="'$(SmokeAvaloniaVersion)' == ''">12.1.1</SmokeAvaloniaVersion>
    <DefineConstants Condition="'$(MediaPackageVersion)' != ''">$(DefineConstants);PACKAGE_CONSUMER</DefineConstants>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>../../samples/NativeMedia.Avalonia.Demo/app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/NativeMedia.Avalonia.Windows/NativeMedia.Avalonia.Windows.csproj" Condition="'$(MediaPackageVersion)' == ''" />
    <PackageReference Include="NativeMedia.Avalonia" Version="$(MediaPackageVersion)" Condition="'$(MediaPackageVersion)' != ''" />
    <PackageReference Include="Avalonia.Desktop" Version="$(SmokeAvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(SmokeAvaloniaVersion)" />
  </ItemGroup>
</Project>
