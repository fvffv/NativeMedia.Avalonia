<Project>
  <!-- NuGet selects compatible consumers, including newer and platform-specific TFMs.
       Do not restrict registration to the library's exact target framework. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)NativeMedia.Avalonia.AutoRegistration.g.cs"
             Link="NativeMedia.Avalonia.AutoRegistration.g.cs"
             Visible="false" />
  </ItemGroup>
</Project>
